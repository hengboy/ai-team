{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.local/schemas/agent-build/role-v1.json",
  "title": "AI Team agent-build role",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "purpose", "writes", "staging", "delegates", "commands", "discovery", "enforcement"],
  "properties": {
    "id": { "$ref": "#/$defs/role" },
    "purpose": { "type": "string", "minLength": 1 },
    "writes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_entries"],
      "properties": {
        "owned_entries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["project-context", "planning-documents", "planning-tasks", "dispatch-packet", "dispatch-result", "decision", "git-reconcile-evidence", "research-conclusions", "review-result", "review-resolution"] }
        }
      }
    },
    "delegates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(planning start|planning revision .+|planning tasks .+|coding start|context .+|dispatch .+|decision create|staging .+|scope check|run .+|review .+|research .+|git .+|install|env .+|backup restore|uninstall)$"
      }
    },
    "discovery": { "type": "boolean" },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_scope", "read_scope", "write_scope"],
      "properties": {
        "command_scope": { "$ref": "#/$defs/enforcementLevel" },
        "read_scope": { "$ref": "#/$defs/enforcementLevel" },
        "write_scope": { "$ref": "#/$defs/enforcementLevel" }
      }
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "planning",
        "coding",
        "file-explorer",
        "frontend-developer",
        "backend-developer",
        "test",
        "git-operator",
        "code-reviewer",
        "review-spec",
        "review-standards",
        "environment-operator",
        "researcher"
      ]
    },
    "enforcementLevel": { "enum": ["mechanical", "instruction", "unsupported"] }
  }
}
